# CAUSORA_JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
# CAUSORA_REDACTION_SECRET=replace-with-a-separate-random-32-byte-or-longer-secret
# CAUSORA_ALLOWED_ORIGINS=https://dashboard.example.com
